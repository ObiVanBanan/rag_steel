APP_ENV=development
LOG_LEVEL=INFO
SEARCH_TRACE_ENABLED=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=steel_products_active
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
NO_PROXY=localhost,127.0.0.1,qdrant,.local,172.16.0.0/12,10.0.0.0/8
# Set these only if your deployment requires an outbound proxy.
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=10

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=10

DENSE_BATCH_SIZE=32
MAX_CONCURRENT_SEARCHES=8
QDRANT_TIMEOUT_SECONDS=5
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.25
SOURCE_CANDIDATE_LIMIT=300
# Minimum dense similarity score before RRF.
# Empty/undefined disables filtering.
DENSE_SCORE_THRESHOLD=
# Minimum BM25 score before RRF.
# Empty/undefined disables filtering.
BM25_SCORE_THRESHOLD=

RESULT_LIMIT_DEFAULT=20
RESULT_LIMIT_MAX=100

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
