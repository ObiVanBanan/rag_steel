APP_ENV=development
LOG_LEVEL=INFO

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=steel_products_active
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_DTYPE=float16
EMBEDDING_NORMALIZE=true
EMBEDDING_MAX_SEQ_LENGTH=512

DENSE_BATCH_SIZE=32
SOURCE_CANDIDATE_LIMIT=300

RESULT_LIMIT_DEFAULT=20
RESULT_LIMIT_MAX=100

SOURCE_SCORE_HYBRID_WEIGHT=0.55
SOURCE_SCORE_TEXT_EXACTNESS_WEIGHT=0.25
SOURCE_SCORE_FIELD_WEIGHT=0.20
